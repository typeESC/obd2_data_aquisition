# Environment variables for OBD Data Logger API
# Copy this file to .env and modify the values as needed

# Database Configuration
POSTGRES_DB=obd_logger
POSTGRES_USER=obd_user
POSTGRES_PASSWORD=obd_secure_password_123
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# API Configuration
API_PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# Alert Thresholds
HIGH_RPM_THRESHOLD=6000
HIGH_COOLANT_TEMP_THRESHOLD=105
LOW_FUEL_THRESHOLD=10.0
HIGH_OIL_TEMP_THRESHOLD=140
LOW_VOLTAGE_THRESHOLD=11.5

# Data Retention
DATA_RETENTION_DAYS=365
CLEANUP_INTERVAL_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Batch Processing
MAX_BATCH_SIZE=1000
MAX_REQUEST_SIZE=10485760  # 10MB

# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@obd.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Nginx Configuration (Optional)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8001
